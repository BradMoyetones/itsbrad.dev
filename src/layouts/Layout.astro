---
import '@fontsource/geist-sans';
import '@fontsource/geist-mono';
import '@fontsource/ibm-plex-serif';
import '@fontsource/caveat';
import '../styles/globals.css';
import SiteHeader from '@/components/SiteHeader.astro';
import { SiteFooterCad } from '@/components/site-footer-cad';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Brad Portfolio</title>
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const isDark = getThemePreference() === 'dark';
			document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
			
			if (typeof localStorage !== 'undefined') {
				const observer = new MutationObserver(() => {
					const isDark = document.documentElement.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		</script>
	</head>
	<body class="bg-background text-foreground antialiased selection:bg-selection selection:text-selection-foreground">
		<div class="group/layout relative isolate">
			<SiteHeader />
			<main class="max-w-screen overflow-x-clip px-2">
				<slot />
			</main>
			<SiteFooterCad client:idle />
			<div class="pointer-events-none fixed inset-x-0 bottom-0 z-50" aria-hidden="true">
				<div class="h-(--fade-bottom-height) bg-linear-to-b from-transparent to-background mask-linear-[to_top,var(--background)_25%,transparent] backdrop-blur-[1px]"></div>
				<div class="bg-background pb-[env(safe-area-inset-bottom,0)]"></div>
			</div>
		</div>
	</body>
</html>
