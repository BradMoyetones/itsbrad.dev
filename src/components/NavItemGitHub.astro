---
import { SOURCE_CODE_GITHUB_REPO } from "@/config/site"
import { GitHubStars } from "@/components/github-stars"

let stargazersCount = 0

try {
  const response = await fetch(
    `https://api.github.com/repos/${SOURCE_CODE_GITHUB_REPO}`,
    {
      headers: {
        Accept: "application/vnd.github+json",
        // Authorization: `Bearer ${import.meta.env.GITHUB_API_TOKEN}`,
        "X-GitHub-Api-Version": "2026-03-10",
      },
    }
  )

  if (response.ok) {
    const json = await response.json()
    stargazersCount = Number(json?.stargazers_count) || 0
  }
} catch (e) {
  // Ignore
}
---

<GitHubStars repo={SOURCE_CODE_GITHUB_REPO} stargazersCount={stargazersCount} client:load />
