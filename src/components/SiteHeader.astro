---
import { MAIN_NAV } from "@/config/site"
import { Separator } from "@/components/ui/separator"
import NavDesktop from "@/components/NavDesktop.astro"
import { ThemeToggle } from "@/components/theme-toggle"
import { BradMark } from "@/components/brad-mark"
---

<header class="sticky top-0 z-50 max-w-screen overflow-x-clip bg-background px-2">
  <div class="screen-line-top screen-line-bottom mx-auto flex h-(--header-height) items-center gap-2 border-x screen-line-bottom-border screen-line-top-border pr-2 pl-4 group-has-data-[slot=layout-wide]/layout:container after:z-1 sm:gap-4 md:max-w-3xl">
      <a href="/" aria-label="Home">
        <BradMark className="h-6 shrink-0" />
      </a>

    <div class="flex-1"></div>

    <NavDesktop items={MAIN_NAV} />

    <div class="flex items-center">
      <Separator
        orientation="vertical"
        className="mx-2 data-vertical:h-5 data-vertical:self-center"
      />
      <ThemeToggle client:load />
    </div>
  </div>
</header>
